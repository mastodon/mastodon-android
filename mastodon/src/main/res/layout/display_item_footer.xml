<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:orientation="horizontal"
	android:layout_width="match_parent"
	android:layout_height="56dp"
	android:paddingBottom="12dp"
	android:paddingTop="6dp"
	android:paddingLeft="8dp"
	android:paddingRight="8dp">

	<FrameLayout
		android:id="@+id/reply_btn"
		android:layout_width="wrap_content"
		android:layout_height="match_parent"
		android:paddingStart="8dp"
		android:paddingEnd="12dp"
		android:background="@drawable/bg_status_action">
		<TextView
			android:id="@+id/reply"
			android:layout_width="wrap_content"
			android:layout_height="32dp"
			android:layout_gravity="center|start"
			android:drawableStart="@drawable/ic_phosphor_reply_20px"
			android:drawablePadding="4dp"
			android:drawableTint="?colorM3OnSurface"
			android:textColor="?colorM3OnSurface"
			android:gravity="center_vertical"
			android:textAppearance="@style/m3_label_large"
			android:duplicateParentState="true"
			android:alpha="0.7"
			tools:text="123"/>
	</FrameLayout>

	<FrameLayout
		android:id="@+id/boost_btn"
		android:layout_width="wrap_content"
		android:layout_height="match_parent"
		android:paddingStart="8dp"
		android:paddingEnd="12dp"
		android:background="@drawable/bg_status_action">
		<TextView
			android:id="@+id/boost"
			android:layout_width="wrap_content"
			android:layout_height="24dp"
			android:layout_gravity="center|start"
			android:drawableStart="@drawable/ic_repeat_selector"
			android:drawablePadding="4dp"
			android:drawableTint="?colorM3OnSurface"
			android:textColor="?colorM3OnSurface"
			android:gravity="center_vertical"
			android:textAppearance="@style/m3_label_medium"
			android:duplicateParentState="true"
			android:alpha="0.7"
			tools:text="123"/>
	</FrameLayout>

	<FrameLayout
		android:id="@+id/favorite_btn"
		android:layout_width="wrap_content"
		android:layout_height="match_parent"
		android:paddingStart="8dp"
		android:paddingEnd="12dp"
		android:background="@drawable/bg_status_action">
		<TextView
			android:id="@+id/favorite"
			android:layout_width="wrap_content"
			android:layout_height="24dp"
			android:layout_gravity="center|start"
			android:drawableStart="@drawable/ic_heart_selector"
			android:drawablePadding="4dp"
			android:drawableTint="?colorM3OnSurface"
			android:textColor="?colorM3OnSurface"
			android:gravity="center_vertical"
			android:textAppearance="@style/m3_label_medium"
			android:duplicateParentState="true"
			android:alpha="0.7"
			tools:text="123"/>
	</FrameLayout>

	<Space
		android:layout_width="0px"
		android:layout_height="1px"
		android:layout_weight="1"/>

	<FrameLayout
		android:id="@+id/bookmark_btn"
		android:layout_width="wrap_content"
		android:layout_height="match_parent"
		android:layout_marginStart="4dp"
		android:paddingHorizontal="8dp"
		android:background="@drawable/bg_status_action_centered"
		android:minWidth="34dp">
		<ImageView
			android:id="@+id/bookmark"
			android:layout_width="wrap_content"
			android:layout_height="24dp"
			android:layout_gravity="center"
			android:src="@drawable/ic_bookmark_selector"
			android:tint="?colorM3OnSurface"
			android:alpha="0.7"
			android:gravity="center_vertical"/>
	</FrameLayout>

	<FrameLayout
		android:id="@+id/menu_btn"
		android:layout_width="wrap_content"
		android:layout_height="match_parent"
		android:layout_marginStart="4dp"
		android:paddingHorizontal="8dp"
		android:background="@drawable/bg_status_action_centered"
		android:minWidth="34dp">
		<ImageView
			android:id="@+id/menu"
			android:layout_width="wrap_content"
			android:layout_height="24dp"
			android:layout_gravity="center"
			android:src="@drawable/ic_phosphor_menu_20px"
			android:tint="?colorM3OnSurface"
			android:alpha="0.7"
			android:gravity="center_vertical"/>
	</FrameLayout>

</LinearLayout>