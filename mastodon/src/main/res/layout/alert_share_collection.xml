<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	
	<FrameLayout
		android:id="@+id/collection_wrap"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"/>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:layout_marginHorizontal="16dp"
		android:layout_marginTop="16dp"
		android:orientation="horizontal"
		android:background="@drawable/round_rect"
		android:backgroundTint="?colorM3SecondaryContainer"
		android:gravity="center_vertical|start">

		<TextView
			android:id="@+id/url"
			android:layout_width="0px"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginStart="16dp"
			android:singleLine="true"
			android:ellipsize="end"
			android:textAppearance="@style/m3_body_medium"
			android:textColor="?colorM3OnSurface"
			tools:text="https://mastodon.social/collections/3141432434"/>

		<ImageButton
			android:id="@+id/copy_link"
			android:layout_width="52dp"
			android:layout_height="52dp"
			android:layout_marginStart="-8dp"
			android:background="@drawable/bg_round_ripple_inset_8dp"
			android:src="@drawable/ic_phosphor_copy_simple_light"
			android:tint="?colorM3OnSurface"
			android:contentDescription="@string/fallback_menu_item_copy_link"/>

	</LinearLayout>

</LinearLayout>