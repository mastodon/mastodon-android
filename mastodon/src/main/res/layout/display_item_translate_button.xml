<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:paddingHorizontal="16dp"
	android:clipToPadding="false">

	<Button
		android:id="@+id/button"
		android:layout_width="wrap_content"
		android:layout_height="32dp"
		android:layout_marginStart="-8dp"
		style="@style/Widget.Mastodon.M3.Button.Text"
		android:minWidth="0px"
		android:paddingHorizontal="12dp"
		android:drawableStart="@drawable/ic_phosphor_language_20px"
		android:drawablePadding="4dp"
		android:drawableTint="@color/button_text_m3_text"
		android:text="@string/translate_post"/>

	<TextView
		android:id="@+id/translation_info"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:textAppearance="@style/m3_body_small"
		android:textColor="?colorM3OnSurfaceVariant"
		tools:text="Translated from Russian using DeepL.com"/>

</LinearLayout>